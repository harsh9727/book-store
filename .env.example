# Required in production for canonical URLs, sitemap entries, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Contact form configuration.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Server-only EmailJS password-reset configuration. The service/public key may
# reuse the contact values above; the reset template and private key must remain
# server-only. Configure the template recipient as {{to_email}} and show
# {{otp_code}}, {{expires_minutes}}, and {{application_name}} in its content.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=

# Server-only UploadThing token used by authenticated admin image uploads.
UPLOADTHING_TOKEN=

# Required for server-side admin login. Generate these with `npm run admin:setup`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace-with-generated-salt$replace-with-generated-derived-key
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_VERSION=1
ADMIN_REQUIRE_MFA=true
ADMIN_TOTP_SECRET=replace-with-generated-base32-secret

# Set true only when the deployment proxy overwrites X-Forwarded-For with a trusted client IP.
ADMIN_TRUST_PROXY=false
